<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
     <div class="container">
        <div class="left-panel">
            <h1>WELCOME BACK!</h1>
            <p>Enter your personal details to use art or safe features</p>
            <button class="signin-btn">SIGN IN</button>
        </div>
        <div class="right-panel">
            <h2>Create Account</h2>
            <div>
                <img src="facebook-color-svgrepo-com.svg" alt="facebook" class="icon">
                <img src="Cybersecurity glossary (terms and definitions).jpg" alt="" class="icon">
            </div>
            <p>Or use your Email for registration</p>
            <input type="text" placeholder="NAME:">
            <br>
            <input type="text" placeholder="email:">
            <br>
            <input type="password" placeholder="password">
            <br>
            <button class="signup-btn">SIGN UP</button>
        </div>
    </div>
</body>
</html>
.*{
    box-sizing: border-box;
    padding: 0%;
    margin: 0%;
}
body{
    background-color:rgb(175, 174, 174);
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
}
input{
    margin: 7px;
}

.container{
    width:600px;
    height: 420px;
    background: rgb(213, 228, 198);
    border-radius: 2em;
    display: flex;
    overflow: auto;
    box-shadow: 0 15px 25px
    lch(5.98% 0.44 19.18);
}
.left-panel{
    text-align:center;
    background-color: rgb(155, 212, 219);
    border-radius: 0px 120px 65px 0;
    overflow:auto;
    width: 60%;
    color: white;
}
.left-panel h1{
    margin-top: 90px;
    font-style: italic;
    font-family: cursive;
    font-size: 35px;
}
.left-panel p{
    margin-top: 45px;
}
.left-panel button:hover{
    background-color: rgb(229, 238, 149);
    cursor: pointer;
}
.signin-btn{
    margin-top: 20px;
    border-radius: 5px;
    padding-bottom: 3px;
    padding-left: 20px;
    padding-right:20px;
    padding-top: 3px;
    background: none;
    color: white;
}
.right-panel{
    margin-left: 30px;
    margin-top: 80px;
}
.right-panel button:hover{
    background-color: aquamarine;
    cursor: pointer;
}
.signup-btn{
align-content: center;
margin-top: 15px;
margin-left: 55px;
background: none;
padding-left: 20px;
padding-right: 20px;
padding-top: 3px;
padding-bottom: 3px;
border-radius: 5px;
}
.icon{
    width: 200px;
    height: 20px;
}
.right-panel p{
    font-size: 15px;
    margin-left: 15px;
}

